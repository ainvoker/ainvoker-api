NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@host/db?sslmode=verify-full
NEON_AUTH_URL=https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth
# Must match the SPA origin for CORS (http is fine for local app).
# Xendit Components origins are sent as HTTPS separately (see XENDIT_COMPONENTS_ORIGIN).
CORS_ORIGIN=http://localhost:5173
# Provider keys are optional at boot; required only when calling that provider
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# Billing (Xendit) — set BILLING_ENABLED=true to require live checkout
BILLING_ENABLED=false
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
# Pro price in PHP centavos (109900 = ₱1,099.00)
XENDIT_PRO_AMOUNT=109900
# Required HTTPS origin(s) for Xendit Components API (comma-separated).
# Local app can stay on http://localhost:5173; use mock SDK in DEV, or ngrok HTTPS for real Components.
XENDIT_COMPONENTS_ORIGIN=https://localhost:5173

# Organization invites. Production emails the accept link (Cloudflare Email Sending) and does not return it.
# Local/dev: leave email off and set INVITE_RETURN_ACCEPT_URL=true to copy the link in the Team UI.
# INVITE_RETURN_ACCEPT_URL is ignored in production. The raw token is never returned.
INVITE_EMAIL_ENABLED=false
INVITE_RETURN_ACCEPT_URL=true
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
INVITE_EMAIL_FROM=AInvoker <invites@yourdomain.com>
# 1. Create a Neon branch named `test` from your main branch
# 2. Copy .env.test.example → .env.test and set DATABASE_URL to the test branch connection string
# 3. Run: npm test
