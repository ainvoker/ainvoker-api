NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
NEON_AUTH_URL=https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth
CORS_ORIGIN=http://localhost:5173
# Provider keys are optional at boot; required only when calling that provider
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# For tests use a separate Neon branch — see .env.test.example
# 1. Create a Neon branch named `test` from your main branch
# 2. Copy .env.test.example → .env.test and set DATABASE_URL to the test branch connection string
# 3. Run: npm test
