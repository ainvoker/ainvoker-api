// AInvoker Prisma schema (final)
// App rule on signup: create a default Organization (e.g. name "Personal") + owner OrganizationMember.
// Rate/token limits are enforced in application code from Subscription → Plan (no RateLimit table).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ───────────────────────────────────────────────────────────────────

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ProjectEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DISABLED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
}

enum AIModelType {
  TEXT
  IMAGE
  AUDIO
  MULTIMODAL
  EMBEDDING
  OTHER
}

enum AIServiceType {
  TEXT
  IMAGE
  ACTION
}

enum AIRequestStatus {
  PENDING
  SUCCESS
  FAILED
  REJECTED
}

enum ActionInvocationStatus {
  REQUESTED
  REPORTED_SUCCESS
  REPORTED_FAILURE
}

enum WebhookEvent {
  REQUEST_FAILED
  RATE_LIMIT_EXCEEDED
  USAGE_ALERT
}

enum WebhookStatus {
  ACTIVE
  DISABLED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PlanBillingMode {
  FIXED_MONTHLY
  METERED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ── Auth profile ────────────────────────────────────────────────────────────

enum ThemePreference {
  LIGHT
  DARK
  DEVICE
}

model User {
  id              String           @id // Neon Auth user ID
  email           String?          @unique
  firstName       String?
  lastName        String?
  profilePicture  String?
  themePreference ThemePreference  @default(DEVICE)

  memberships           OrganizationMember[]
  createdOrganizations  Organization[]       @relation("OrganizationCreator")
  activityLogs          ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Membership roles: seed names `owner` | `admin` | `member`
model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  members OrganizationMember[]
}

// ── Organization ────────────────────────────────────────────────────────────

model Organization {
  id     String             @id @default(cuid())
  name   String
  slug   String             @unique
  status OrganizationStatus @default(ACTIVE)

  createdByUserId String?
  createdBy       User?   @relation("OrganizationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  xenditCustomerReference String?
  xenditCustomerId        String?
  xenditPaymentTokenId    String?
  /// Display-only snapshot of the saved payment method (never full PAN).
  paymentMethodType       String?
  paymentMethodBrand      String?
  paymentMethodLast4      String?

  members       OrganizationMember[]
  projects      Project[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  id String @id @default(cuid())

  organizationId String
  userId         String
  roleId         Int

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

// ── Project ─────────────────────────────────────────────────────────────────

model Project {
  id String @id @default(cuid())

  organizationId String

  name        String
  description String?
  environment ProjectEnvironment
  status      ProjectStatus      @default(ACTIVE)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  apiKeys         ApiKey[]
  actions         Action[]
  aiRequests      AIRequest[]
  usageAnalytics  UsageAnalytics[]
  webhooks        Webhook[]
  allowedOrigins  ProjectAllowedOrigin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ── Allowed browser origins (SDK CORS) ──────────────────────────────────────

model ProjectAllowedOrigin {
  id String @id @default(cuid())

  projectId String
  origin    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, origin])
  @@index([origin])
  @@index([projectId])
}

// ── API keys ────────────────────────────────────────────────────────────────

model ApiKey {
  id String @id @default(cuid())

  projectId String

  keyName    String
  keyHash    String       @unique
  keyPrefix  String
  permissions Json?
  lastUsed   DateTime?
  expiresAt  DateTime?
  status     ApiKeyStatus @default(ACTIVE)

  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requests AIRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// ── AI catalog ──────────────────────────────────────────────────────────────

model AIProvider {
  id Int @id @default(autoincrement())

  name          String        @unique
  baseUrl       String
  documentation String?
  status        CatalogStatus @default(ACTIVE)

  models AIModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIModel {
  id Int @id @default(autoincrement())

  providerId Int

  name          String
  type          AIModelType
  contextWindow Int
  inputPrice    Decimal       @db.Decimal(12, 6)
  outputPrice   Decimal       @db.Decimal(12, 6)
  status        CatalogStatus @default(ACTIVE)
  /// When true, orgs on the Free plan may call this model.
  freeEligible  Boolean       @default(false)

  provider AIProvider  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  requests AIRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, name])
  @@index([providerId])
}

// ── Requests & actions ──────────────────────────────────────────────────────

model AIRequest {
  id String @id @default(cuid())

  projectId String
  apiKeyId  String
  modelId   Int

  serviceType AIServiceType

  requestPayload  Json
  responsePayload Json?

  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  latency      Int?
  requestCost  Decimal? @db.Decimal(12, 6)

  requestStatus AIRequestStatus @default(PENDING)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiKey  ApiKey  @relation(fields: [apiKeyId], references: [id], onDelete: Restrict)
  model   AIModel @relation(fields: [modelId], references: [id], onDelete: Restrict)

  actionInvocations ActionInvocation[]

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([apiKeyId])
  @@index([createdAt])
}

/// Registry-only action definition. Execution happens in the client/SDK.
model Action {
  id String @id @default(cuid())

  projectId String

  name         String
  description  String?
  inputSchema  Json
  outputSchema Json?

  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invocations ActionInvocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
}

/// Audit of tool calls observed/reported during a gateway request (not server-side execution).
model ActionInvocation {
  id String @id @default(cuid())

  requestId String
  actionId  String

  executionStatus ActionInvocationStatus
  executionResult Json?

  request AIRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  action  Action   @relation(fields: [actionId], references: [id], onDelete: Restrict)

  executedAt DateTime @default(now())

  @@index([requestId])
  @@index([actionId])
}

// ── Analytics ───────────────────────────────────────────────────────────────

model UsageAnalytics {
  id String @id @default(cuid())

  projectId String

  totalRequests      Int     @default(0)
  successfulRequests Int     @default(0)
  failedRequests     Int     @default(0)
  totalTokens        Int     @default(0)
  totalCost          Decimal @default(0) @db.Decimal(12, 6)

  month Int
  year  Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, month, year])
  @@index([projectId])
}

// ── Platform event webhooks (not Action execution) ──────────────────────────

model Webhook {
  id String @id @default(cuid())

  projectId String

  webhookUrl String
  secret     String
  event      WebhookEvent
  status     WebhookStatus @default(ACTIVE)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// ── Billing (per Organization) ──────────────────────────────────────────────

model Plan {
  id Int @id @default(autoincrement())

  name         String          @unique
  monthlyPrice Decimal         @db.Decimal(12, 6)
  tokenLimit   Int
  requestLimit Int
  billingMode  PlanBillingMode
  description  String?

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id String @id @default(cuid())

  organizationId String
  planId         Int

  status               SubscriptionStatus @default(ACTIVE)
  startedAt            DateTime
  /// Next renewal date while auto-renewing; access ends here when cancelAtPeriodEnd.
  expiresAt            DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  xenditSessionId      String?
  xenditRecurringPlanId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([xenditRecurringPlanId])
}

model Transaction {
  id String @id @default(cuid())

  subscriptionId String

  amount          Decimal       @db.Decimal(12, 6)
  paymentMethod   String
  referenceNumber String        @unique
  paymentStatus   PaymentStatus @default(PENDING)
  description     String?
  receiptUrl      String?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
}

// ── User activity audit ─────────────────────────────────────────────────────

model ActivityLog {
  id String @id @default(cuid())

  userId String

  activity  String
  ipAddress String?
  browser   String?
  device    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
