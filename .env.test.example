# Copy to .env.test and fill in values before running `npm test`.
#
# Neon test branch (create once):
# 1. Neon Console → Branches → Create branch named `test` (parent = your main branch)
# 2. Connect → copy the Postgres URL for the `test` branch into DATABASE_URL below
#
# Reset dirty data later by resetting/recreating the branch, or rely on test cleanup helpers.

NODE_ENV=test
PORT=3000
DATABASE_URL=postgresql://user:password@ep-xxx-test.region.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_URL=https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth
CORS_ORIGIN=http://localhost:5173
# Dummy OK in tests — upstream OpenAI is mocked
OPENAI_API_KEY=test-openai-key
