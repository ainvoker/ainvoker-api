# Copy to .env.test and fill in values before running `npm test`.
#
# Neon test branch (create once):
# 1. Neon Console → Branches → Create branch named `test` (parent = your main branch)
# 2. Connect → copy the Postgres URL for the `test` branch into DATABASE_URL below
#
# Reset dirty data later by resetting/recreating the branch, or rely on test cleanup helpers.

NODE_ENV=test
PORT=3000
DATABASE_URL=postgresql://user:password@ep-xxx-test.region.aws.neon.tech/neondb?sslmode=verify-full
NEON_AUTH_URL=https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth
CORS_ORIGIN=http://localhost:5173
# Dummy OK in tests — upstream providers are mocked
OPENAI_API_KEY=test-openai-key
GEMINI_API_KEY=test-gemini-key
BILLING_ENABLED=false
# Tests mock the mailer and capture the accept link from the outbound payload.
INVITE_EMAIL_ENABLED=true
INVITE_RETURN_ACCEPT_URL=false
RESEND_API_KEY=test-resend-key
INVITE_EMAIL_FROM=AInvoker <invites@example.com>
